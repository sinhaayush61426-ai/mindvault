# Copy to .env and set values appropriate for this installation.
# For an existing vault, preserve its original ENCRYPTION_KEY.
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_PATH=instance/mindvault.db
ENCRYPTION_KEY=replace-with-a-valid-fernet-key
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
