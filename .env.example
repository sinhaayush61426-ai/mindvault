# ================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ================================
#
# Purpose:
#   Template for local development environment setup
#   Copy this file to .env and fill in your values
#
# Setup Instructions:
#   1. cp .env.example .env
#   2. Edit .env with your configuration
#   3. source .env (or add to shell profile)
#   4. python3 app.py to start
#
# SECURITY WARNING:
#   - Never commit .env to repository
#   - Keep .env file local and private
#   - Rotate SECRET_KEY periodically
#   - Use strong ENCRYPTION_KEY
#
# Production Deployment:
#   - Store secrets in environment variables
#   - Use secrets manager (AWS Secrets Manager, etc.)
#   - Never use default values
#   - Enforce HTTPS and secure cookies
#
# Last Modified: June 1, 2026
#
# ====== MindVault Configuration - Copy to .env for local development ======

# Flask Configuration
FLASK_ENV=development
DEBUG=False
SECRET_KEY=change-me-to-a-secure-random-key-in-production

# Database
DATABASE_URL=sqlite:///instance/database.db

# Encryption (Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-base64-fernet-key-here

# Security
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SYMBOLS=True
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT=900

# Session
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=604800

# Content Limits
MAX_ENTRY_LENGTH=1000000
MAX_CHARACTER_NAME=100
MAX_CHARACTER_FIELD=5000
MAX_REVIEW_LENGTH=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/mindvault.log
